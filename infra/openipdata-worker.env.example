# Runtime environment for openipdata-worker.service.
# Installed at /etc/openipdata/worker.env (root:openipdata, 0640). Edit with: sudoedit /etc/openipdata/worker.env
# Secrets live only here: never put them in Hatchet task inputs, outputs, or log lines.

# API token from the Hatchet dashboard for the openipdata tenant.
HATCHET_CLIENT_TOKEN=

# Postgres connection string. For Supabase use the session pooler (IPv4, port 5432).
# sync-geofeeds' probe-domains task needs it too (read only), and so does resolve-ips.
PGSQL=

# PeeringDB API key (sync-peeringdb workflow), from your peeringdb.com profile.
PDB_KEY=

# --- Publishing (build-asn-data "publish" task) ----------------------------------
# Cloudflare R2 bucket for the dated MMDB + asn.sqlite3 uploads, as one URL.
# sync-geofeeds also stores its layer files there (internal/layers/), so keep the bucket private.
#   https://<access-key-id>:<secret-access-key>@<account-id>.r2.cloudflarestorage.com/<bucket>
# Use an R2 API token with "Object Read & Write" on this bucket only.
R2=

# GitHub fine-grained token with "Contents: Read and write" on the repo below only.
# The MMDB goes to that repo's rolling "latest" release.
GITHUB_TOKEN=
# GITHUB_REPO=shingrus/openipdata.org

# Optional healthchecks.io ping URLs, called after each successful publish.
# build-geo-data skips its ping while the geofeed rows are over 3 days old.
HC_PING_ASN=
HC_PING_GEO=

# Optional IPinfo token (build-geo-data "evaluate" task): downloads the IPinfo Lite country MMDB
# (https://ipinfo.io/data/ipinfo_lite.mmdb) as a reference to score the ip2geo MMDB against.
# Without it that reference is skipped. It is a secret and sits in the download URL: it is never logged.
IPINFO_TOKEN=

# Worker state directory (default matches init-hatchet-runner-vm.sh).
OPENIPDATA_DATA_DIR=/var/lib/openipdata
