# Runtime environment for openipdata-worker.service.
# Installed at /etc/openipdata/worker.env (root:openipdata, 0640). Edit with: sudoedit /etc/openipdata/worker.env
# Secrets live only here: never put them in Hatchet task inputs, outputs, or log lines.

# API token from the Hatchet dashboard for the openipdata tenant.
HATCHET_CLIENT_TOKEN=

# Postgres connection string. For Supabase use the session pooler (IPv4, port 5432).
PGSQL=

# Worker state directory (default matches init-hatchet-runner-vm.sh).
OPENIPDATA_DATA_DIR=/var/lib/openipdata
