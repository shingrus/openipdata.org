[Unit]
Description=openipdata.org: install a new website binary from the GitHub release "site"
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/openipdata-site/openipdata-site.env
ExecStart=/opt/openipdata-site/bin/openipdata-site-update
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# Sandbox: not yet tested on the VM. systemctl reaches systemd over D-Bus (AF_UNIX socket in /run).
# /etc/nginx/conf.d: the updater switches the live link there. /var/log/nginx and /var/lib/nginx:
# "nginx -t" opens the log files and the temp paths. /run: the lock file.
ProtectSystem=strict
ReadWritePaths=/opt/openipdata-site /var/lib/openipdata-site/state /etc/nginx/conf.d /var/log/nginx /var/lib/nginx /run
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
