# Settings of the openipdata-site timers (root:openipdata-site 0640). No secrets of ours live here.
# The repo whose GitHub releases (site, latest) are downloaded.
GITHUB_REPO=shingrus/openipdata.org
# healthchecks.io ping URL for the binary updater (empty: no pings).
HC_PING_SITE=
# healthchecks.io ping URL for the data puller (MMDBs and the ASN SQLite file) (empty: no pings).
HC_PING_MMDB=
# ntfy.sh topic URL (https://ntfy.sh/<long random topic>): one push when a new site build goes live.
# The topic name is the secret (anyone who knows it can read it): never logged. Empty: no push.
NTFY_URL=
# The DNS beacon (r.openipdata.org): the public addresses of this VM, where Knot answers on port 53.
# Normally leave both empty: the init script takes the addresses of v4.openipdata.org and
# v6.openipdata.org when they are addresses of this machine. Set them only when that fails (NAT).
PUBLIC_IPV4=
PUBLIC_IPV6=
