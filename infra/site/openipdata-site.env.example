# Settings of the openipdata-site timers (root:openipdata-site 0640). No secrets of ours live here.
# The repo whose GitHub releases (site, latest) are downloaded.
GITHUB_REPO=shingrus/openipdata.org
# healthchecks.io ping URL for the binary updater (empty: no pings).
HC_PING_SITE=
# healthchecks.io ping URL for the MMDB puller (empty: no pings).
HC_PING_MMDB=
