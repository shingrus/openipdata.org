# /etc/iplistener/iplistener.env (root:iplistener 0640). Fill in every value, then:
#   systemctl restart iplistener

# Postgres connection string of the iplistener role (secret). With Supabase use the
# session pooler string and sslmode=verify-full (or require).
PGSQL=

# Access log to follow, e.g. /var/log/nginx/access.log
LOG_FILE=

# Go (RE2) regexp; a line is kept when it matches. E.g. FILTER='"POST /api/\w+' or FILTER='"GET /api/beacon'
# systemd parses this file: single quotes keep backslashes and double quotes literally.
FILTER=''

# Optional Go regexp; a matching line is dropped. E.g. EXCLUDE='cc=T1|bot|crawl|spider'
EXCLUDE=''

# Short label stored in visitor_ips.source
SOURCE=
