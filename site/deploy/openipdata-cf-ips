#!/usr/bin/env bash
# Refreshes the Cloudflare address ranges for nginx. Runs as root (weekly timer, and once by the init script).
# Writes one file, /etc/nginx/conf.d/cloudflare-realip.conf: set_real_ip_from + real_ip_header CF-Connecting-IP
# (so $remote_addr is the visitor) and a geo block that sets $from_cloudflare to 1 when the connection
# really comes from a Cloudflare range ($realip_remote_addr, the peer before realip). The site
# answers 444 when it is 0. (nginx allow/deny cannot be used: they test the address after realip.)
# Refuses to write when a list is empty or a line is not a valid CIDR.
#
# Overrides for tests only: CF_V4_URL, CF_V6_URL, CONF_FILE, NGINX, SYSTEMCTL.
set -euo pipefail

CF_V4_URL="${CF_V4_URL:-https://www.cloudflare.com/ips-v4}"
CF_V6_URL="${CF_V6_URL:-https://www.cloudflare.com/ips-v6}"
CONF_FILE="${CONF_FILE:-/etc/nginx/conf.d/cloudflare-realip.conf}"
NGINX="${NGINX:-nginx}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"

log() {
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"
}

fail() {
    log "error: $*"
    exit 1
}

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# fetch_list URL FAMILY (4 or 6) OUTFILE: writes the validated CIDRs, one per line.
fetch_list() {
    local url=$1 fam=$2 out=$3 line count=0 o prefix addr
    curl -fsS -m 30 --retry 3 -o "$WORK/raw$fam" "$url" 2>/dev/null || fail "cannot download $url"
    : >"$out"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line//$'\r'/}"
        [[ -z "$line" ]] && continue
        addr="${line%/*}"
        prefix="${line#*/}"
        [[ "$line" == */* && "$prefix" =~ ^[0-9]{1,3}$ ]] || fail "invalid line in $url"
        if [[ "$fam" == 4 ]]; then
            [[ "$addr" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || fail "invalid IPv4 range in $url"
            for o in ${addr//./ }; do ((10#$o <= 255)) || fail "invalid IPv4 range in $url"; done
            ((10#$prefix <= 32)) || fail "invalid IPv4 prefix in $url"
        else
            [[ "$addr" =~ ^[0-9a-fA-F:]+$ && "$addr" == *:*:* ]] || fail "invalid IPv6 range in $url"
            ((10#$prefix <= 128)) || fail "invalid IPv6 prefix in $url"
        fi
        printf '%s\n' "$line" >>"$out"
        count=$((count + 1))
    done <"$WORK/raw$fam"
    ((count > 0)) || fail "$url is empty"
}

fetch_list "$CF_V4_URL" 4 "$WORK/v4"
fetch_list "$CF_V6_URL" 6 "$WORK/v6"

{
    echo "# Generated by openipdata-cf-ips from $CF_V4_URL and $CF_V6_URL; do not edit."
    cat "$WORK/v4" "$WORK/v6" | while IFS= read -r c; do echo "set_real_ip_from $c;"; done
    echo "real_ip_header CF-Connecting-IP;"
    echo "real_ip_recursive off;"
    echo "geo \$realip_remote_addr \$from_cloudflare {"
    echo "    default 0;"
    cat "$WORK/v4" "$WORK/v6" | while IFS= read -r c; do echo "    $c 1;"; done
    echo "}"
} >"$WORK/new.conf"

if [[ -f "$CONF_FILE" ]] && cmp -s "$WORK/new.conf" "$CONF_FILE"; then
    log "Cloudflare ranges unchanged"
    exit 0
fi

had_old=0
if [[ -f "$CONF_FILE" ]]; then
    cp -p "$CONF_FILE" "$WORK/old.conf"
    had_old=1
fi
install -d -m 0755 "$(dirname "$CONF_FILE")"
cp "$WORK/new.conf" "$CONF_FILE.tmp"
chmod 0644 "$CONF_FILE.tmp"
mv -f "$CONF_FILE.tmp" "$CONF_FILE"

if ! "$NGINX" -t >/dev/null 2>"$WORK/nginx-t.err"; then
    if ((had_old)); then
        cp -p "$WORK/old.conf" "$CONF_FILE.tmp"
        mv -f "$CONF_FILE.tmp" "$CONF_FILE"
    else
        rm -f "$CONF_FILE"
    fi
    tail -n 5 "$WORK/nginx-t.err" >&2 || true
    fail "nginx -t failed with the new ranges; the previous file is restored"
fi
log "wrote $CONF_FILE ($(wc -l <"$WORK/v4" | tr -d ' ') IPv4 and $(wc -l <"$WORK/v6" | tr -d ' ') IPv6 ranges)"
if "$SYSTEMCTL" is-active --quiet nginx; then
    "$SYSTEMCTL" reload nginx
    log "nginx reloaded"
fi
